<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_6dp"
    android:backgroundTint="@color/medium_green"
    app:cardCornerRadius="@dimen/list_item_radius_12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_12dp"
        android:paddingVertical="@dimen/margin_6dp">

        <ImageView
            android:contentDescription="@string/profile_picture_img_description"
            android:id="@+id/profilePic"
            android:layout_width="@dimen/initials_circle_background_40dp"
            android:layout_height="@dimen/initials_circle_background_40dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:visibility="visible"
            android:background="@drawable/circle_image"
            android:src="@drawable/ic_profile_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <TextView
            android:id="@+id/tv_initials_selected_users"
            android:layout_width="@dimen/initials_circle_background_40dp"
            android:layout_height="@dimen/initials_circle_background_40dp"
            android:background="@drawable/circle_image"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@color/off_white"
            android:textSize="@dimen/name_text_size_list_item_20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/initials_default_text" />

        <TextView
            android:id="@+id/tv_name_selected_users"
            android:layout_width="@dimen/size_0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_6dp"
            android:fontFamily="@font/bagel_fat_one"
            android:gravity="center_vertical"
            android:textColor="@color/off_white"
            android:textSize="@dimen/name_text_size_list_item_20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_initials_selected_users"
            app:layout_constraintTop_toTopOf="@id/tv_initials_selected_users"
            tools:text="@string/list_item_name_default_text" />

        <TextView
            android:id="@+id/tv_add_friend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_16dp"
            android:fontFamily="@font/quantico_bold"
            android:text="@string/add_friend"
            android:textColor="@color/off_white"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tv_initials_selected_users"
            app:layout_constraintTop_toBottomOf="@id/tv_name_selected_users" />

        <!--        <TextView-->
        <!--            android:id="@+id/tv_delete_friend"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:fontFamily="@font/quantico_bold"-->
        <!--            android:textSize="@dimen/add_friend_text_size_list_item_12sp"-->
        <!--            android:text="@string/friends"-->
        <!--            android:textColor="@color/off_white"-->
        <!--            android:visibility="visible"-->
        <!--            app:layout_constraintStart_toStartOf="@id/tv_name_selected_users"-->
        <!--            app:layout_constraintTop_toBottomOf="@id/tv_name_selected_users" />-->


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>