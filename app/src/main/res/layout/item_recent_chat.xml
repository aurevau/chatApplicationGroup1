<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_6dp"
    android:background="@color/medium_green"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/margin_16dp">

    <FrameLayout
        android:id="@+id/fl_ChatIcon"
        android:layout_width="@dimen/size_60dp"
        android:layout_height="@dimen/size_60dp"
        android:visibility="gone">

        <!-- Rund bakgrund -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_background_white" />

        <!-- Bild -->
        <ImageView
            android:id="@+id/ivChatIcon"
            android:layout_width="@dimen/initials_circle_background_40dp"
            android:layout_height="@dimen/initials_circle_background_40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/group_chat_img_description"
            android:src="@drawable/group_icon"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Rund profilbild med initialer – coolare version -->
    <TextView

        android:id="@+id/tvProfileInitials"
        android:layout_width="@dimen/size_60dp"
        android:layout_height="@dimen/size_60dp"
        android:background="@drawable/circle_image"
        android:gravity="center"
        android:textAllCaps="true"
        android:textColor="@color/off_white"
        android:textSize="@dimen/name_text_size_list_item_20sp"
        android:textStyle="bold"
        android:visibility="visible"
        tools:text="@string/initials_default_text" />

    <ImageView
        android:contentDescription="@string/profile_picture_img_description"
        android:id="@+id/profilePic"
        android:layout_width="@dimen/size_60dp"
        android:layout_height="@dimen/size_60dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:background="@drawable/circle_image"
        android:src="@drawable/ic_profile_placeholder"

        />

    <!-- Namn och senaste meddelande -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChatName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bagel_fat_one"
            android:maxLines="4"
            android:textColor="@color/white"
            android:textSize="@dimen/name_text_size_list_item_20sp"
            android:textStyle="bold"
            tools:text="@string/list_item_name_default_text" />

        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_last_message"
            android:textColor="@color/off_white"
            android:textSize="@dimen/last_chat_text_size_recent_list_item_14sp" />
    </LinearLayout>

    <!-- Tidstämpel -->
    <TextView
        android:id="@+id/tvTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/off_white"
        android:textSize="@dimen/chat_time_text_size_12sp"
        tools:text="@string/default_time_13_37" />

</LinearLayout>